{
  "name": "@uraiai/voice-core",
  "version": "0.0.0",
  "description": "Framework-agnostic engine for Urai voice calls",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "devDependencies": {
    "@uraiai/voice-test-support": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "urai",
    "voice",
    "webrtc",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/uraiai/urai-voice-sdk",
    "directory": "packages/voice-core"
  }
}
